# ==================== STRIPE CONFIGURATION ====================
# Obtenha suas chaves em: https://dashboard.stripe.com/apikeys
# Use chaves de teste (sk_test_...) para desenvolvimento
# Use chaves de produção (sk_live_...) apenas em produção

STRIPE_SECRET_KEY=sk_test_sua_chave_secreta_aqui

# ==================== URL DA APLICAÇÃO ====================
# URL base da sua aplicação (necessário para redirects do Stripe)
# Desenvolvimento: http://localhost:3000
# Produção: https://seudominio.com

NEXT_PUBLIC_URL=http://localhost:3000

# ==================== IMPORTANTE: CONFIGURAR PRODUTOS NO STRIPE ====================
# 
# Os sorteios e pacotes agora são carregados AUTOMATICAMENTE dos produtos do Stripe!
# 
# Para adicionar um sorteio, crie um produto no Stripe Dashboard:
# https://dashboard.stripe.com/products
# 
# Configure os seguintes METADADOS no produto:
# - totalNumeros: 10000 (quantidade total de números do sorteio)
# - numerosVendidos: 0 (quantidade já vendida - atualizar manualmente)
# - valorPremio: 10000 (valor do prêmio em reais)
# - dataSorteio: 2026-02-15 (data do sorteio no formato YYYY-MM-DD)
# - destaque: true (ou false - para aparecer com badge de destaque)
# 
# PACOTES PERSONALIZADOS (OPCIONAL):
# - pacotes: [{"id":"p1","quantidade":1,"preco":5},{"id":"p2","quantidade":5,"preco":20}]
#   Se não configurar, serão gerados automaticamente com descontos progressivos
#   baseados no preço por número do produto (5%, 10%, 15%, 20%, 25% de desconto)
# 
# Configure também:
# - Nome do produto: será o título do sorteio
# - Descrição: será a descrição do sorteio
# - Imagem: será a foto do card
# - Preço padrão: será o preço por número (usado para calcular pacotes se não configurar o metadado)
# 
# EXEMPLO DE METADADOS:
# totalNumeros: 10000
# numerosVendidos: 0
# valorPremio: 50000
# dataSorteio: 2026-03-15
# destaque: true
# pacotes: [{"id":"p1","quantidade":1,"preco":10},{"id":"p2","quantidade":5,"preco":45},{"id":"p3","quantidade":10,"preco":80},{"id":"p4","quantidade":25,"preco":180},{"id":"p5","quantidade":50,"preco":320},{"id":"p6","quantidade":100,"preco":550}]
# 
# ==================== STRIPE PRODUCT IDs (OPCIONAL - NÃO USADO) ====================
# Não é mais necessário configurar IDs manualmente
# Os produtos são buscados automaticamente via API

# NEXT_PUBLIC_STRIPE_PRODUCT_MOTO=
# NEXT_PUBLIC_STRIPE_PRODUCT_IPHONE=
# NEXT_PUBLIC_STRIPE_PRODUCT_DINHEIRO=
# NEXT_PUBLIC_STRIPE_PRODUCT_PS5=

# ==================== WEBHOOK STRIPE (PRODUÇÃO) ====================
# Endpoint secret para validar webhooks do Stripe
# Obtenha em: https://dashboard.stripe.com/webhooks
# Formato: whsec_XXXXXXXXXXXXX
# IMPORTANTE: Só funciona com HTTPS em produção

# STRIPE_WEBHOOK_SECRET=whsec_seu_webhook_secret_aqui
